# Copy this file to `.env` and fill in your own Supabase project values.
# Never commit real credentials. See README.md for Supabase setup notes.

# Public URL of your Supabase project (Project Settings > API).
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Publishable / anon public key of your Supabase project (Project Settings > API).
# Row Level Security (RLS) must still be enforced in your Supabase tables.
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
